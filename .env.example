# 复制为 .env 后填写。不要把真实 API Key 提交到 Git。
SECVAL_EMBEDDING_PROVIDER=api
# 可填写 OpenAI 兼容基础地址或完整接口，例如 https://host/v1 或 https://host/v1/embeddings
SECVAL_EMBEDDING_API_URL=
SECVAL_EMBEDDING_API_KEY=
SECVAL_EMBEDDING_API_MODEL=qwen3.7-text-embedding
SECVAL_EMBEDDING_API_DIMENSION=1024
SECVAL_EMBEDDING_API_BATCH_SIZE=64
SECVAL_EMBEDDING_API_TIMEOUT_SECONDS=120
# 远程模型必须使用独立 Collection，避免与旧本地向量混合。
SECVAL_VECTOR_COLLECTION=secval-code-vectors-qwen37-api-v1

# 独立审计配置；正式服务不会自动借用搜索凭据。
SECVAL_AUDIT_API_URL=
SECVAL_AUDIT_API_KEY=
SECVAL_AUDIT_MODEL=glm-5.3-flash
# 单次网络等待参数，不是整个审计任务的硬性截止时间。
SECVAL_AUDIT_TIMEOUT_SECONDS=120
SECVAL_AUDIT_MAX_OUTPUT_TOKENS=8192
# 留空不发送供应商扩展；确认接口支持后才设置enabled或disabled。
SECVAL_AUDIT_THINKING=
# 仅在确认供应商支持流式响应后启用；断流不会执行半截动作。
SECVAL_AUDIT_STREAM=false

# Neo4j与Joern的Docker内部地址由compose设置；密码使用config下的Docker secret文件，
# 不要把真实密码写进此文件或提交到Git。
